generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
}

model Account {
  id              String           @id
  type            String
  email           String           @unique
  displayName     String           @map("display_name")
  imapHost        String           @map("imap_host")
  imapPort        Int              @map("imap_port")
  imapSecure      Boolean          @map("imap_secure")
  smtpHost        String           @map("smtp_host")
  smtpPort        Int              @map("smtp_port")
  smtpSecure      Boolean          @map("smtp_secure")
  username        String
  authType        String           @map("auth_type")
  encryptedSecret String           @map("encrypted_secret")
  createdAt       BigInt           @map("created_at")
  updatedAt       BigInt           @map("updated_at")
  folders         Folder[]
  messages        Message[]
  messageBodies   MessageBody[]
  recentFolders   RecentFolder[]
  drafts          Draft[]
  messageIdKeys   MessageIdKey[]
  leftOutMessages LeftOutMessage[]
  messageMarks    MessageMark[]

  @@map("accounts")
}

model Folder {
  id            String  @id
  accountId     String  @map("account_id")
  path          String
  name          String
  delimiter     String?
  specialUse    String? @map("special_use")
  messageCount  Int     @default(0) @map("message_count")
  unseenCount   Int     @default(0) @map("unseen_count")
  uidValidity   String? @map("uid_validity")
  highestModseq String? @map("highest_modseq")
  lastKnownUid  Int?    @map("last_known_uid")
  uidNext       Int?    @map("uid_next")
  lastSyncedAt  BigInt? @map("last_synced_at")
  updatedAt     BigInt  @map("updated_at")
  account       Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, path])
  @@index([accountId], map: "idx_folders_account")
  @@map("folders")
}

model Message {
  id              String      @id
  accountId       String      @map("account_id")
  folderPath      String      @map("folder_path")
  uid             Int
  /// Who the message is, whichever folder holds it (see `message-identity.ts`).
  messageKey      String      @map("message_key")
  /// The conversation: the server's thread, or the message that started it.
  threadId        String      @map("thread_id")
  messageId       String?     @map("message_id")
  subject         String
  subjectSort     String      @default("") @map("subject_sort")
  fromJson        String      @map("from_json")
  toJson          String      @map("to_json")
  ccJson          String      @map("cc_json")
  bccJson         String      @default("[]") @map("bcc_json")
  dateIso         String      @map("date_iso")
  preview         String
  previewHydrated Boolean     @default(false) @map("preview_hydrated")
  flagsJson       String      @map("flags_json")
  isRead          Boolean     @map("is_read")
  isFlagged       Boolean     @default(false) @map("is_flagged")
  senderName      String      @default("") @map("sender_name")
  senderKey       String      @default("") @map("sender_key")
  senderLabel     String      @default("") @map("sender_label")
  senderSort      String      @default("") @map("sender_sort")
  hasAttachments  Boolean     @map("has_attachments")
  size            Int
  searchFrom      String      @default("") @map("search_from")
  searchTo        String      @default("") @map("search_to")
  searchSubject   String      @default("") @map("search_subject")
  searchPreview   String      @default("") @map("search_preview")
  /// What the message is in certified mail (PEC), when it is the provider's: `busta`, `anomalia`, a receipt's kind.
  pecKind         String?     @map("pec_kind")
  /// The Message-ID the sender's client gave the message carried or receipted (X-Riferimento-Message-ID).
  pecRef          String?     @map("pec_ref")
  updatedAt       BigInt      @map("updated_at")
  account         Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  searchHits      SearchHit[]

  @@unique([accountId, folderPath, uid])
  @@index([accountId, messageKey], map: "idx_messages_key")
  @@index([accountId, threadId], map: "idx_messages_thread")
  @@index([accountId, folderPath, dateIso], map: "idx_messages_folder_date")
  @@index([accountId, folderPath, senderSort], map: "idx_messages_folder_sender_sort")
  @@index([senderKey], map: "idx_messages_sender_key")
  @@index([accountId, folderPath, subjectSort], map: "idx_messages_folder_subject_sort")
  @@index([accountId, folderPath, isFlagged], map: "idx_messages_folder_flagged")
  @@index([accountId, pecRef], map: "idx_messages_pec_ref")
  @@map("messages")
}

/// A message's body, once per message however many folders hold it, with
/// the words the full-text index (`message_fts`, FTS5) reads. Cache.
model MessageBody {
  id              Int     @id @default(autoincrement())
  accountId       String  @map("account_id")
  messageKey      String  @map("message_key")
  /// 1: the text alone (the indexer); 2: the message as the reader shows it.
  level           Int
  html            String?
  text            String?
  attachmentsJson String  @default("[]") @map("attachments_json")
  replyToJson     String  @default("[]") @map("reply_to_json")
  referencesJson  String  @default("[]") @map("references_json")
  /// A certified envelope's certification and the provider's words (`PecDetail`), as JSON.
  pecJson         String? @map("pec_json")
  subject         String  @default("")
  sender          String  @default("")
  recipients      String  @default("")
  body            String  @default("")
  fetchedAt       BigInt  @map("fetched_at")
  account         Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, messageKey])
  @@map("message_bodies")
}

/// The rows the full-text index found for a search on screen, under a token
/// per search (see `AppDatabase.indexHitsToken`). Transient.
model SearchHit {
  token     String
  messageId String  @map("message_id")
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([token, messageId])
  @@map("search_hits")
}

/// The people the composer suggests: everyone the stored mail names, the
/// ones the user writes to counted (see `AppDatabase.recordContactsWritten`).
model Contact {
  emailNormalized String  @id @map("email_normalized")
  emailAddress    String  @map("email_address")
  displayName     String? @map("display_name")
  nameNormalized  String? @map("name_normalized")
  /// Messages the user wrote to the address.
  usageCount      Int     @default(0) @map("usage_count")
  /// When the user last wrote to it, 0 when never.
  lastUsedAt      BigInt  @map("last_used_at")
  /// The newest message the address sent the user, null when it never did.
  lastReceivedAt  BigInt? @map("last_received_at")
  /// When the user took it out of the suggestions; writing to it again brings it back.
  hiddenAt        BigInt? @map("hidden_at")
  updatedAt       BigInt  @map("updated_at")

  @@index([lastUsedAt], map: "idx_contacts_last_used")
  @@index([nameNormalized], map: "idx_contacts_name_normalized")
  @@map("contacts")
}

/// Files the user attached, saved from a message or filed away through an
/// extension. The "Allega" menu offers them back, newest first.
/// Which message holds each `m:` key of an account, by its content: kept after its rows go,
/// for a message stored again to find its key (`mail-engine/message-id-keys.ts`).
model MessageIdKey {
  accountId     String  @map("account_id")
  messageKey    String  @map("message_key")
  threadId      String  @map("thread_id")
  contentDigest String  @map("content_digest")
  leftAt        BigInt? @map("left_at")
  account       Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, messageKey])
  @@map("message_id_keys")
}

/// Messages a folder's sync leaves out for now: deleted by the app and not expunged yet, or
/// refused by the server (`mail-engine/unreadable-messages.ts`).
model LeftOutMessage {
  accountId  String  @map("account_id")
  folderPath String  @map("folder_path")
  uid        Int
  reason     String
  failures   Int     @default(0)
  retryAt    BigInt? @map("retry_at")
  account    Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, folderPath, uid])
  @@map("left_out_messages")
}

model RecentFolder {
  accountId  String  @map("account_id")
  folderPath String  @map("folder_path")
  usedAt     BigInt  @map("used_at")
  account    Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, folderPath])
  @@index([accountId, usedAt], map: "idx_recent_folders_account_used_at")
  @@map("recent_folders")
}

/// Messages being written: kept here as they are typed, so nothing is lost
/// to a crash or a lost connection, and filed in the account's Bozze as they
/// settle (see `DraftService`).
model Draft {
  id              String  @id
  accountId       String  @map("account_id")
  /// new, reply or forward.
  kind            String
  sourceAccountId String? @map("source_account_id")
  toJson          String  @default("[]") @map("to_json")
  ccJson          String  @default("[]") @map("cc_json")
  bccJson         String  @default("[]") @map("bcc_json")
  subject         String  @default("")
  html            String  @default("")
  inReplyTo       String? @map("in_reply_to")
  referencesJson  String  @default("[]") @map("references_json")
  /// The message a reply or forward is about, with its attachments.
  originalJson    String? @map("original_json")
  attachmentsJson String  @default("[]") @map("attachments_json")
  /// Saves made so far, and the one the server's copy holds.
  revision        Int     @default(0)
  serverRevision  Int     @default(0) @map("server_revision")
  /// Where the server's copy is: its account, folder and UID.
  serverAccountId String? @map("server_account_id")
  serverFolder    String? @map("server_folder")
  serverUid       Int?    @map("server_uid")
  serverSavedAt   BigInt? @map("server_saved_at")
  /// Open in a composer, or parked in the dock, as the app last left it.
  docked          Boolean @default(false)
  createdAt       BigInt  @map("created_at")
  updatedAt       BigInt  @map("updated_at")
  account         Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId], map: "idx_drafts_account")
  @@map("drafts")
}

model RecentFile {
  path     String @id
  activity String
  usedAt   BigInt @map("used_at")

  @@index([usedAt], map: "idx_recent_files_used_at")
  @@map("recent_files")
}

/// What an extension did with a message outside the mail (`MessageMark`):
/// its words, where, the files, when. Kept with the mail, gone with its
/// account.
model MessageMark {
  extension   String
  accountId   String  @map("account_id")
  messageKey  String  @map("message_key")
  threadId    String  @map("thread_id")
  /// Who wrote it, lower case: where their next message goes is learnt from it.
  fromAddress String? @map("from_address")
  label       String
  /// A folder, or '' without one.
  place       String  @default("")
  filesJson   String  @default("[]") @map("files_json")
  markedAt    BigInt  @map("marked_at")
  account     Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([extension, accountId, messageKey, place])
  @@index([accountId, messageKey], map: "idx_message_marks_message")
  @@index([accountId, threadId], map: "idx_message_marks_thread")
  @@index([fromAddress], map: "idx_message_marks_from")
  @@map("message_marks")
}

model AppPreference {
  id                             Int     @id
  unifiedInboxIncludedAccountIds String? @map("unified_inbox_included_account_ids")
  themeMode                      String  @default("system") @map("theme_mode")
  layoutMode                     String  @default("apple") @map("layout_mode")
  invertMessageListDefaultOrder  Boolean @default(false) @map("invert_message_list_default_order")
  messageListSortField           String  @default("date") @map("message_list_sort_field")
  messageListSortDirection       String  @default("desc") @map("message_list_sort_direction")
  messageGrouping                String  @default("auto") @map("message_grouping")
  readerZoom                     Int     @default(100) @map("reader_zoom")
  readerDetailsOpen              Boolean @default(false) @map("reader_details_open")
  shortcutOverrides              String  @default("{}") @map("shortcut_overrides")
  newEventCalendarKey            String? @map("new_event_calendar_key")
  newEventMinutes                Int     @default(60) @map("new_event_minutes")
  updatedAt                      BigInt  @map("updated_at")

  @@map("app_preferences")
}

/// The Segretario's tables are created and migrated by `src/main/ai/schema.ts`
/// (versioned in `ai_meta`), and read with SQL by the registry, the notebook,
/// the work queue and `AiStore`: these models describe them. User data, kept
/// across updates; "Elimina tutti i dati" empties them.

/// The schema's version, and other facts about the tables themselves.
model AiMeta {
  key   String @id
  value String

  @@map("ai_meta")
}

/// The Segretario's settings: one row. The OpenRouter key is kept encrypted
/// with the system keychain (`safeStorage`), like the accounts' passwords.
model AiSettings {
  id              Int     @id
  encryptedApiKey String? @map("encrypted_api_key")
  /// What the last check of the key found (see `SegretarioStatus`), as JSON.
  keyStatusJson   String  @default("{}") @map("key_status_json")
  /// `SegretarioPreferences` (the one switch), as JSON.
  preferencesJson String  @default("{}") @map("preferences_json")
  updatedAt       BigInt  @map("updated_at")

  @@map("ai_settings")
}

/// What each call to the model cost, by task, for Impostazioni → Segretario.
model AiUsage {
  id               Int     @id @default(autoincrement())
  createdAt        BigInt  @map("created_at")
  activityId       String? @map("activity_id")
  /// The task of the run (`TaskKind`), or `compattazione`, `titolo`.
  purpose          String
  model            String?
  provider         String?
  promptTokens     Int     @map("prompt_tokens")
  cachedTokens     Int     @map("cached_tokens")
  completionTokens Int     @map("completion_tokens")
  reasoningTokens  Int     @map("reasoning_tokens")
  cost             Float

  @@index([createdAt], map: "idx_ai_usage_created")
  @@map("ai_usage")
}

/// One run of the Segretario — asked by the user, or woken by the engine —
/// and its page in the panel or the diary.
model AiActivity {
  id         String    @id
  /// The task, as first written (kept for old rows); `task` says it now.
  kind       String
  task       String?
  title      String
  status     String
  /// `pannello` (a conversation), `diario` (work done alone), `nascosta`.
  visibility String    @default("pannello")
  /// The unit of `ai_work` it runs, for work done alone.
  workId     String?   @map("work_id")
  /// What it was woken for (`WorkScope`), as JSON.
  scopeJson  String?   @map("scope_json")
  createdAt  BigInt    @map("created_at")
  updatedAt  BigInt    @map("updated_at")
  unseen     Boolean   @default(false)
  cost       Float     @default(0)
  events     AiEvent[]

  @@index([updatedAt], map: "idx_ai_activities_updated")
  @@map("ai_activities")
}

/// What happened in a run, in order, never rewritten: the task and context,
/// the user's words, the model's turns with their tool calls, the tools'
/// results, confirmations, compactions, the changes made. The conversation
/// the model reads is rebuilt from it.
model AiEvent {
  id          Int        @id @default(autoincrement())
  activityId  String     @map("activity_id")
  type        String
  payloadJson String     @map("payload_json")
  createdAt   BigInt     @map("created_at")
  activity    AiActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId, id], map: "idx_ai_events_activity")
  @@map("ai_events")
}

/// The units of work the engine wakes the Segretario for: one waiting per
/// scope (a partial unique index on `scope_key`), retried with a pause,
/// taken up again after a restart.
model AiWork {
  id         String  @id
  task       String
  scopeKey   String  @map("scope_key")
  scopeJson  String  @map("scope_json")
  priority   Int
  /// `in_coda`, `al_lavoro`, `fatto`, `da_riprovare`, `fallito`, `annullato`.
  status     String
  attempts   Int     @default(0)
  notBefore  BigInt  @map("not_before")
  activityId String? @map("activity_id")
  lastError  String? @map("last_error")
  createdAt  BigInt  @map("created_at")
  updatedAt  BigInt  @map("updated_at")

  @@index([status, priority, notBefore], map: "idx_ai_work_status")
  @@map("ai_work")
}

/// The Segretario's notebook: what it knows of the user, their connections,
/// people and matters, as notes it writes and the user can read, correct and
/// restore (Impostazioni → Segretario).
model AiMemory {
  path      String  @id
  content   String
  createdAt BigInt  @map("created_at")
  updatedAt BigInt  @map("updated_at")
  readAt    BigInt  @map("read_at")
  revision  Int     @default(1)
  /// `utente`, or the run that wrote it last.
  updatedBy String? @map("updated_by")

  @@map("ai_memory")
}

/// Every version a note had, the last ones: who changed it and how.
model AiMemoryHistory {
  id       Int     @id @default(autoincrement())
  path     String
  revision Int
  /// The note as it was after the change; null once deleted.
  content  String?
  action   String
  actor    String
  runId    String? @map("run_id")
  at       BigInt

  @@index([path, id], map: "idx_ai_memory_history_path")
  @@map("ai_memory_history")
}

/// Getting to know each connection: when Conoscimi began, in which run, and
/// when it finished. A connection without a finished row is still to know.
model AiLearning {
  accountId  String  @id @map("account_id")
  activityId String? @map("activity_id")
  startedAt  BigInt  @map("started_at")
  finishedAt BigInt? @map("finished_at")

  @@map("ai_learning")
}

/// How far back each connection is read one by one — `days`, decided by the
/// Segretario in Conoscimi or by the user in chat, with why; none decided,
/// the default — and, for a calendar, the span of its events looked at
/// (`looked_from` in, `looked_until` out, by when they start).
model AiReading {
  connectionKey String  @id @map("connection_key")
  days          Int?
  reason        String?
  setBy         String? @map("set_by")
  setAt         BigInt? @map("set_at")
  lookedFrom    BigInt? @map("looked_from")
  lookedUntil   BigInt? @map("looked_until")

  @@map("ai_reading")
}

/// What the next reflection takes in: the user's corrections and decisions
/// (a draft changed before sending, a commitment not needed, a project
/// renamed, a proposal set aside…). `reflection_id` is the run that took it in.
model AiLesson {
  id           Int     @id @default(autoincrement())
  kind         String
  payloadJson  String  @map("payload_json")
  createdAt    BigInt  @map("created_at")
  reflectionId String? @map("reflection_id")

  @@index([reflectionId], map: "idx_ai_lessons_reflection")
  @@map("ai_lessons")
}

/// The drafts the Segretario wrote, as it wrote them: what the user sends is
/// compared with this.
model AiDraft {
  draftId    String  @id @map("draft_id")
  /// The run that wrote it, or prepared the reply taken up.
  activityId String? @map("activity_id")
  accountId  String  @map("account_id")
  text       String
  /// The whole draft as the Segretario left it — words, recipients, subject,
  /// files — as JSON: while it is still exactly so, the draft is its own to rewrite.
  snapshot   String?
  createdAt  BigInt  @map("created_at")

  @@map("ai_drafts")
}

/// What a message said when it came: its note. Historical — corrected when
/// wrong, not rewritten as the matter moves on. By the message's stable key.
model AiNote {
  accountId     String  @map("account_id")
  messageKey    String  @map("message_key")
  threadId      String  @map("thread_id")
  direction     String
  summary       String
  /// Its nature (`NoteNature`): asks a reply, asks to do, awaited, informs, noise.
  nature        String  @map("state")
  priority      String
  reason        String
  due           String?
  messageDate   String  @map("message_date")
  createdAt     BigInt  @map("created_at")
  updatedAt     BigInt? @map("updated_at")
  /// Unused since the registry: what is open decides the views.
  dismissedAt   BigInt? @map("dismissed_at")
  /// The other account this same message came to, whose note this copies.
  twinAccountId String? @map("twin_account_id")
  revision      Int     @default(1)
  runId         String? @map("run_id")
  /// `utente` once the user corrected it: no run alone writes over it.
  writtenBy     String  @default("segretario") @map("written_by")

  @@id([accountId, messageKey])
  @@index([accountId, threadId], map: "idx_ai_notes_thread")
  @@index([nature, messageDate], map: "idx_ai_notes_state")
  @@map("ai_notes")
}

/// Something open between the user and someone — asked of them, promised,
/// awaited, to do — with its life: open, done, not needed, put off. It comes
/// from a message (account, conversation, message), from an event, or from
/// the user's word — with the project it is about, if any.
model AiItem {
  id          Int     @id @default(autoincrement())
  accountId   String? @map("account_id")
  threadId    String? @map("thread_id")
  messageKey  String? @map("message_key")
  eventKey    String? @map("event_key")
  projectId   String? @map("project_id")
  kind        String
  text        String
  due         String?
  /// `aperta`, `fatta`, `non_serve`, `rinviata` (until `until`).
  status      String
  until       String?
  createdAt   BigInt  @map("created_at")
  updatedAt   BigInt? @map("updated_at")
  closedAt    BigInt? @map("closed_at")
  /// Who set the status last: `utente`, `segretario`, `sistema`.
  closedBy    String? @map("closed_by")
  reason      String?
  /// The message that proves the last change.
  evidenceKey String? @map("evidence_key")
  createdBy   String  @default("segretario") @map("created_by")
  runId       String? @map("run_id")
  /// What the Segretario asks the user about it, when it cannot tell.
  question    String?
  revision    Int     @default(1)

  @@index([accountId, threadId], map: "idx_ai_items_thread")
  @@index([status, due], map: "idx_ai_items_status")
  @@index([eventKey], map: "idx_ai_items_event")
  @@index([projectId], map: "idx_ai_items_project")
  @@map("ai_items")
}

/// Every change a commitment went through, to show it and to undo it.
model AiItemHistory {
  id         Int     @id @default(autoincrement())
  itemId     Int     @map("item_id")
  at         BigInt
  actor      String
  runId      String? @map("run_id")
  action     String
  beforeJson String? @map("before_json")
  afterJson  String  @map("after_json")
  reason     String?

  @@index([itemId, id], map: "idx_ai_item_history_item")
  @@index([runId], map: "idx_ai_item_history_run")
  @@map("ai_item_history")
}

/// A reply or a reminder the Segretario prepared ahead, local until the user
/// takes it up: ready, to look at again, used, discarded, overtaken.
model AiReadyDraft {
  accountId   String  @map("account_id")
  messageKey  String  @map("message_key")
  threadId    String  @map("thread_id")
  /// `risposta`, or `sollecito` after the user's own message.
  kind        String  @default("risposta")
  text        String
  doubts      String
  /// `pronta`, `da_rivedere`, `usata`, `scartata`, `superata`.
  status      String
  staleReason String? @map("stale_reason")
  createdAt   BigInt  @map("created_at")
  updatedAt   BigInt? @map("updated_at")
  revision    Int     @default(1)
  runId       String? @map("run_id")

  @@id([accountId, messageKey])
  @@index([status], map: "idx_ai_ready_drafts_status")
  @@map("ai_ready_drafts")
}

/// A matter that lasts — a job, a project; a pratica in the company build —
/// found by the Segretario or made by the user, with "Il punto".
model AiProject {
  id          String  @id
  title       String
  /// Who named it: a name the user gave is not changed by a run alone.
  titleBy     String  @map("title_by")
  description String?
  /// "Il punto": how things stand, and when it was written.
  state       String?
  stateAt     BigInt? @map("state_at")
  /// Since when "Il punto" is behind what happened.
  staleSince  BigInt? @map("stale_since")
  origin      String
  hiddenAt    BigInt? @map("hidden_at")
  closedAt    BigInt? @map("closed_at")
  /// Who concluded it, or opened it again: the user's say is not turned over by a run alone.
  closedBy    String? @map("closed_by")
  activeAt    BigInt? @map("active_at")
  revision    Int     @default(1)
  createdAt   BigInt  @map("created_at")
  updatedAt   BigInt  @map("updated_at")

  @@map("ai_projects")
}

/// Which conversations a project holds; one may be in more than one. A link
/// the user took away stays as `rejected`, so no run alone makes it again.
model AiProjectThread {
  projectId String @map("project_id")
  accountId String @map("account_id")
  threadId  String @map("thread_id")
  linkedBy  String @map("linked_by")
  rejected  Int    @default(0)
  createdAt BigInt @map("created_at")

  @@id([projectId, accountId, threadId])
  @@index([accountId, threadId], map: "idx_ai_project_threads_thread")
  @@map("ai_project_threads")
}

/// What a project points to outside the mail: a folder today, drives later.
model AiProjectResource {
  id        Int     @id @default(autoincrement())
  projectId String  @map("project_id")
  kind      String
  location  String
  label     String?
  addedBy   String  @map("added_by")
  createdAt BigInt  @map("created_at")

  @@unique([projectId, location])
  @@map("ai_project_resources")
}

/// Something the Segretario advises and the user decides: an event with
/// guests, an extension's action.
model AiProposal {
  id          String  @id
  kind        String
  accountId   String? @map("account_id")
  messageKey  String? @map("message_key")
  threadId    String? @map("thread_id")
  title       String
  payloadJson String  @map("payload_json")
  /// `aperta`, `accettata`, `scartata`, `superata`.
  status      String
  runId       String? @map("run_id")
  /// Up by one each time a run writes it again: an answer is to the version the user saw.
  revision    Int     @default(1)
  createdAt   BigInt  @map("created_at")
  decidedAt   BigInt? @map("decided_at")
  resultJson  String? @map("result_json")

  @@index([status, kind], map: "idx_ai_proposals_status")
  @@index([accountId, messageKey], map: "idx_ai_proposals_message")
  @@map("ai_proposals")
}

/// A message last seen gone from the cache: past a while with every folder
/// synced, it is taken as deleted and what came of it is settled.
model AiGone {
  accountId  String @map("account_id")
  messageKey String @map("message_key")
  since      BigInt

  @@id([accountId, messageKey])
  @@map("ai_gone")
}

/// A search asked in words that the user kept as a folder: what the question
/// became in the search's own terms, run again each time it is opened.
model AiSavedSearch {
  id        String @id
  question  String
  /// The folder's name.
  summary   String
  /// How it searches, in the search's terms: «offerta» · da settembre.
  how       String
  /// The search itself (`AskedSearch`), as JSON.
  search    String @map("search_json")
  createdAt BigInt @map("created_at")

  @@map("ai_saved_searches")
}

/// The letter at the top of a day ("Oggi"), by local day.
model AiBriefing {
  day       String @id
  text      String
  /// Unused since the registry: kept for old rows.
  basis     String
  createdAt BigInt @map("created_at")

  @@map("ai_briefings")
}

/// How the user may prepare for an event, as the day's run wrote it.
model AiEventPrep {
  eventKey  String  @id @map("event_key")
  text      String
  runId     String? @map("run_id")
  writtenAt BigInt  @map("written_at")

  @@map("ai_event_preps")
}

/// A calendar connection, on its own: a Google or Microsoft account, a CalDAV server, a link.
model CalendarConnection {
  id              String  @id
  /// `google`, `microsoft`, `caldav` (iCloud among them) or `ics` (a link, read only).
  provider        String
  /// The account it reads — an address — or, for a link, the name the user gave it.
  label           String
  /// The mail connection that came with the same access, when there is one: how they are shown together.
  mailAccountId   String? @map("mail_account_id")
  /// The CalDAV server, or the link of the calendar.
  serverUrl       String? @map("server_url")
  username        String?
  /// The token, or the password, encrypted; none for a public link.
  encryptedSecret String? @map("encrypted_secret")
  connectedAt     BigInt  @map("connected_at")
  lastSyncAt      BigInt? @map("last_sync_at")
  /// What went wrong at the last sync, in the user's words.
  problem         String?

  @@map("calendar_connections")
}

/// A calendar of a connection, and where its sync stands.
model CalendarCalendar {
  connectionId String  @map("connection_id")
  calendarId   String  @map("calendar_id")
  name         String
  isPrimary    Int     @map("is_primary")
  /// Whether events can be written in it (the user owns it or may edit it).
  writable     Int     @default(1)
  /// Its colour in the provider, `#rrggbb`.
  color        String?
  /// Hidden by the user in the Calendario app.
  hidden       Int     @default(0)
  /// Whose its events are, as the user chose (`CalendarRole`, vision §7.4); null: not chosen.
  role         String?
  syncToken    String? @map("sync_token")
  /// How far ahead its events were read: past it, they are read again.
  windowEnd    BigInt? @map("window_end")

  @@id([connectionId, calendarId])
  @@map("calendar_calendars")
}

/// A CalDAV calendar's object (one event, a series with its exceptions) as the server has it.
model CalendarObject {
  connectionId String  @map("connection_id")
  calendarId   String  @map("calendar_id")
  url          String
  etag         String?
  /// The iCalendar text.
  data         String

  @@id([connectionId, url])
  @@index([connectionId, calendarId], map: "idx_calendar_objects_calendar")
  @@map("calendar_objects")
}

/// What changed in the calendars not through this app — a new event, one
/// moved, one cancelled, an answer to an invitation — as the sync found it:
/// what the Segretario looks at. Kept a month.
model CalendarChange {
  id           Int     @id @default(autoincrement())
  connectionId String  @map("connection_id")
  eventKey     String  @map("event_key")
  /// `nuovo`, `cambiato`, `annullato`.
  kind         String
  /// The event before and after (`CalendarEvent`), as JSON; null where there is none.
  beforeJson   String? @map("before_json")
  afterJson    String? @map("after_json")
  /// 1 when the user did it in the app; 0 when the sync found it, done elsewhere.
  inApp        Int     @default(0) @map("in_app")
  at           BigInt

  @@index([at], map: "idx_calendar_changes_at")
  @@map("calendar_changes")
}

/// An event of a connected calendar — an instance, for a recurring one.
model CalendarEvent {
  key           String  @id
  connectionId  String  @map("connection_id")
  calendarId    String  @map("calendar_id")
  eventId       String  @map("event_id")
  iCalUid       String? @map("ical_uid")
  /// The series a recurring event's instance belongs to (`CalendarEvent.seriesId`).
  seriesId      String? @map("series_id")
  title         String
  start         String
  end           String
  allDay        Int     @map("all_day")
  /// Its start and end as instants (an all-day event's by local midnight), for ranges.
  startsAt      BigInt  @map("starts_at")
  endsAt        BigInt  @map("ends_at")
  location      String?
  description   String?
  attendeesJson String  @map("attendees_json")
  organizer     String?
  /// Who put it in the calendar, by address, where the calendar says it (Google).
  creator       String?
  myResponse    String? @map("my_response")
  meetLink      String? @map("meet_link")
  htmlLink      String? @map("html_link")
  /// Put there by the Segretario (`EventOrigin`), as the provider's private properties say.
  originJson    String? @map("origin_json")
  /// Its own reminders, minutes before it starts, as JSON; null where it says nothing of them.
  remindersJson String? @map("reminders_json")

  @@index([startsAt, endsAt], map: "idx_calendar_events_range")
  @@index([iCalUid], map: "idx_calendar_events_ical_uid")
  @@map("calendar_events")
}
