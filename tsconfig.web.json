{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts",
    "src/shared/**/*",
    "src/extension/*.ts",
    "src/extension/*.tsx",
    "src/extension/kit/renderer.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"],
      "@shared/*": ["src/shared/*"],
      "@app/extension/renderer": ["src/extension/renderer.public.tsx"],
      "@app/extension/kit/renderer": ["src/extension/kit/renderer.ts"],
      "@app/extension/types": ["src/extension/types.ts"],
      "@app/extension/shared": ["src/extension/shared.public.ts"]
    }
  }
}
