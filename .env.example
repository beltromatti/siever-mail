# Google OAuth Desktop credentials (required for Gmail login)
# Create OAuth Client ID type "Desktop app" in Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Microsoft sign-in (Microsoft 365, Outlook.com: mail over IMAP/SMTP and the calendar over Graph).
# Register an app in Microsoft Entra: accounts in any directory and personal accounts,
# platform "Mobile and desktop applications" with redirect URI http://localhost,
# API permissions IMAP.AccessAsUser.All, SMTP.Send, offline_access (Office 365 Exchange Online)
# and User.Read, Calendars.ReadWrite, Mail.Send (Microsoft Graph). No client secret.
MICROSOFT_OAUTH_CLIENT_ID=
