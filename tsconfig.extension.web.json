{
  // Type-checks the renderer half of the optional extension drop-in.
  // See tsconfig.extension.node.json for why this exists.
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/preload/*.d.ts",
    "src/shared/**/*",
    "src/extension/types.ts",
    "extension/renderer/**/*"
  ],
  "compilerOptions": {
    "composite": false,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"],
      "@shared/*": ["src/shared/*"],
      "@app/extension/renderer": ["extension/renderer/index.tsx"],
      "@app/extension/types": ["src/extension/types.ts"]
    }
  }
}
